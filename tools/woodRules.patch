+/** Rule 2: whether what the hex lacks for a building is spared by its realm and partners (not counting its own surplus). */
+function tradeCovers(sim: Simulation, cell: number, wood: number, stone: number, costWood: number, costStone: number): boolean {
+  const { trade } = sim;
+  const civ = sim.world.owner[cell];
+  const partners = sim.diplomacy.partners[civ];
+  for (let m = 0; m < 2; m++) {
+    const lack = (m === 0 ? costWood - wood : costStone - stone);
+    if (lack <= 0) continue;
+    let spare = (civ + 1) * TRADE_GOODS <= trade.civSpare.length ? trade.civSpare[civ * TRADE_GOODS + m] - trade.surplus[cell * TRADE_GOODS + m] : 0;
+    if (partners) {
+      for (let i = 0; i < partners.length; i++) {
+        const p = partners[i];
+        if ((p + 1) * TRADE_GOODS <= trade.civSpare.length) spare += trade.civSpare[p * TRADE_GOODS + m];
+      }
+    }
+    if (spare < lack) return false;
+  }
+  return true;
+}
+
+/** Rule 1: a production building in its own right where wood or stone income after upkeep is below RULES.prodNet. */
+function planProduction(sim: Simulation, cell: number, netWood: number, netStone: number): boolean {
+  const { economy } = sim;
+  for (let m = 0; m < 2; m++) {
+    const net = m === 0 ? netWood : netStone;
+    if (net >= RULES.prodNet) continue;
+    const good = m === 0 ? Good.Wood : Good.Stone;
+    for (let type = 0; type < BUILDINGS.length; type++) {
+      const b = BUILDINGS[type];
+      if (b.good !== good || !buildingFits(sim, cell, type)) continue;
+      let present = false;
+      let free = false;
+      for (let s = cell * economy.slots, end = s + usableSlots(sim, cell); s < end; s++) {
+        if (economy.state[s] === SlotState.Empty) free = true;
+        else if (economy.type[s] === type && economy.state[s] !== SlotState.Ruin) present = true;
+      }
+      if (present || !free) continue;
+      const share = leaderLever(sim, cell, L.buildCost);
+      if (economy.stock[cell * MATERIAL_COUNT] < b.wood * share || economy.stock[cell * MATERIAL_COUNT + 1] < b.stone * share) continue;
+      if (netFast(sim, cell, Material.Wood, type, -1) < 0 && m !== 0) continue;
+      if (netFast(sim, cell, Material.Stone, type, -1) < 0 && m !== 1) continue;
+      if (startConstruction(sim, cell, -1, type)) return true;
+    }
+  }
+  return false;
+}
